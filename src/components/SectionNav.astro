---
import { url } from '../lib/url';

interface Item {
  label: string;
  path: string;
}

interface Props {
  items: Item[];
  label: string;
}

const { items, label } = Astro.props;
const current = Astro.url.pathname.replace(/\/?$/, '/');
---

<nav class="section-nav" aria-label={label}>
  <div class="container">
    <ul>
      {
        items.map((item) => (
          <li>
            <a href={url(item.path)} aria-current={current === url(item.path) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

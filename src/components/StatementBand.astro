---
interface Props {
  text: string;
  caption?: string;
  tone?: 'ivory' | 'sage';
}

const { text, caption, tone = 'ivory' } = Astro.props;
---

<div class:list={['statement-band', `statement-band--${tone}`]}>
  <div class="container">
    <div class="statement-band__inner">
      <p class="statement-band__text">{text}</p>
      {caption && <p class="statement-band__caption">{caption}</p>}
    </div>
  </div>
</div>

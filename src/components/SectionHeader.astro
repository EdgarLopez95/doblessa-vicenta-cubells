---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  tone?: 'default' | 'light';
}

const { id, eyebrow, title, intro, tone = 'default' } = Astro.props;
---

<div class:list={['section-header', `section-header--${tone}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {intro && <p class="section-header__intro">{intro}</p>}
  <slot />
</div>

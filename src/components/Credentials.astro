---
interface Item {
  label: string;
  value: string;
}

interface Props {
  items: Item[];
  title?: string;
  variant?: 'compact' | 'full';
  note?: string;
  headingLevel?: 'h2' | 'h3';
}

const {
  items,
  title = 'Datos profesionales',
  variant = 'compact',
  note = 'Datos recogidos de la web actual. Pendientes de verificación documental antes de publicar.',
  headingLevel = 'h3',
} = Astro.props;
const Heading = headingLevel;
---

<div class:list={['credentials', `credentials--${variant}`]}>
  <div class="credentials__head">
    <Heading class="credentials__title">{title}</Heading>
    <span class="chip chip--pending">Pendiente de verificación</span>
  </div>
  <dl class="credentials__list">
    {
      items.map((item) => (
        <div class="credentials__row">
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))
    }
  </dl>
  {note && <p class="credentials__note">{note}</p>}
</div>

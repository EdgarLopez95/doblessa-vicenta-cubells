---
import { site } from '../data/site';
import { url } from '../lib/url';
import Icon from './Icon.astro';
---

<div class="action-bar" role="region" aria-label="Acciones rápidas" data-action-bar>
  <a class="action-bar__call" href={site.phones[0].href}>
    <Icon name="phone" size={20} />
    <span>Llamar</span>
  </a>
  <a class="btn btn--primary action-bar__cta" href={url('contacto/')}>Solicitar valoración</a>
</div>

<script>
  // La barra solo aparece cuando los CTA del hero ya no están en pantalla, para no duplicarlos.
  const bar = document.querySelector<HTMLElement>('[data-action-bar]');
  const trigger = document.querySelector('.hero__actions');

  if (bar) {
    const update = () => {
      bar.classList.toggle('is-visible', !trigger || trigger.getBoundingClientRect().bottom < 0);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>

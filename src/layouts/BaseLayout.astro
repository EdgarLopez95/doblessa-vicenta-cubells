---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import type { Crumb } from '../components/Breadcrumbs.astro';
import type { FaqItem } from '../data/faqs';
import { site, images } from '../data/site';
import { url, absoluteUrl } from '../lib/url';

type PageType = 'WebPage' | 'MedicalWebPage' | 'ContactPage' | 'ProfilePage' | 'FAQPage' | 'AboutPage';

interface Props {
  title: string;
  description: string;
  pageType?: PageType;
  breadcrumbs?: Crumb[];
  faqs?: FaqItem[];
  preloadImage?: string;
  ogImage?: string;
  noindex?: boolean;
  showActionBar?: boolean;
}

const {
  title,
  description,
  pageType = 'MedicalWebPage',
  breadcrumbs = [],
  faqs = [],
  preloadImage,
  ogImage = images.portrait.src,
  noindex = false,
  showActionBar = true,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(pathname, Astro.site).href;
const home = absoluteUrl('');
const personId = `${absoluteUrl('dra-vicenta-cubells/')}#persona`;

const questions = faqs.map((item) => ({
  '@type': 'Question',
  name: item.q,
  acceptedAnswer: { '@type': 'Answer', text: item.a },
}));

// JSON-LD prudente: solo datos verificables (nombre, profesión, teléfonos públicos). Sin dirección, reseñas, ofertas ni resultados.
const graph: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': `${home}#website`, url: home, name: site.name, inLanguage: 'es-ES' },
  {
    '@type': 'Person',
    '@id': personId,
    name: 'Vicenta Cubells Santaolaria',
    honorificPrefix: 'Dra.',
    jobTitle: 'Médica',
    telephone: site.phones.map((p) => p.schema),
    image: absoluteUrl(images.portrait.src),
    url: absoluteUrl('dra-vicenta-cubells/'),
  },
  {
    '@type': pageType,
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: 'es-ES',
    isPartOf: { '@id': `${home}#website` },
    ...(pageType === 'ProfilePage' ? { mainEntity: { '@id': personId } } : {}),
    ...(pageType === 'FAQPage' ? { mainEntity: questions } : {}),
  },
];

if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumbs`,
    itemListElement: [{ label: 'Inicio', path: '' }, ...breadcrumbs].map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.label,
      item: absoluteUrl(crumb.path),
    })),
  });
}

if (questions.length && pageType !== 'FAQPage') {
  graph.push({ '@type': 'FAQPage', '@id': `${canonical}#faq`, url: canonical, mainEntity: questions });
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#193831" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(ogImage)} />
    <meta property="og:image:alt" content="Dra. Vicenta Cubells" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=DM+Sans:opsz,wght@9..40,400..700&display=swap"
    />
    {preloadImage && <link rel="preload" as="image" href={url(preloadImage)} fetchpriority="high" />}

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class:list={{ 'has-action-bar': showActionBar }}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {showActionBar && <MobileActionBar />}
  </body>
</html>

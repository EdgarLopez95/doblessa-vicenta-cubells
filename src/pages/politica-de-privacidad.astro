---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { url } from '../lib/url';

const breadcrumbs = [{ label: 'Política de privacidad', path: 'politica-de-privacidad/' }];
---

<BaseLayout
  title="Política de privacidad | Dra. Vicenta Cubells"
  description="Información sobre los datos que se envían al usar este sitio y sus formularios de contacto."
  pageType="WebPage"
  breadcrumbs={breadcrumbs}
  noindex
>
  <Hero eyebrow="Legal" title="Política de privacidad" breadcrumbs={breadcrumbs} />

  <section class="section section--flush-top">
    <div class="container">
      <div class="prose">
        <h2>Formulario de contacto</h2>
        <p>El formulario de esta web no envía, almacena ni transmite la información que se introduce. Para solicitar una cita, contacta directamente con la consulta por teléfono.</p>

        <h2>Navegación y recursos</h2>
        <ul>
          <li>El sitio no utiliza cookies de seguimiento, herramientas analíticas de terceros ni píxeles de rastreo.</li>
          <li>Las tipografías se sirven desde el propio sitio.</li>
        </ul>
        <p>Consulta también el <a href={url('aviso-legal/')}>aviso legal</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>

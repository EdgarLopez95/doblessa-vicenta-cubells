---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import DemoForm from '../components/DemoForm.astro';
import PhoneList from '../components/PhoneList.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import { site, firstVisitSteps } from '../data/site';
import { url } from '../lib/url';

const breadcrumbs = [{ label: 'Contacto', path: 'contacto/' }];
---

<BaseLayout
  title="Contacto y valoración en Nules (Castellón) | Dra. Vicenta Cubells"
  description="Solicita una valoración médica en Nules (provincia de Castellón). Consulta teléfonos, dirección documentada y proceso de cita sin compromiso con la Dra. Vicenta Cubells."
  pageType="ContactPage"
  breadcrumbs={breadcrumbs}
  showActionBar={false}
>
  <Hero
    eyebrow="Contacto"
    title="Solicita una valoración médica"
    lead="Llama a la consulta o deja una solicitud de contacto sin compromiso. Solo hace falta saber cómo localizarte: los datos de salud se tratan siempre en consulta."
    breadcrumbs={breadcrumbs}
  />

  <section class="section section--flush-top" aria-label="Formas de contacto">
    <div class="container contact-layout">
      <div class="contact-block contact-layout__phones">
        <h2>Llama a la consulta</h2>
        <PhoneList variant="cards" />
        <p class="contact-pricing-note mt-16">
          <strong>Cita sin compromiso.</strong> La web original no publica tarifas. Consulta los importes y condiciones vigentes antes de concertar la cita.
        </p>
      </div>

      <div class="contact-layout__form">
        <DemoForm />
      </div>

      <div class="contact-block contact-layout__steps">
        <h2>Cómo empieza la primera valoración</h2>
        <Timeline steps={firstVisitSteps} layout="compact" />
        <a class="text-link mt-32" href={url('como-es-la-primera-consulta/')}>
          <span>Conoce cómo es la primera consulta</span>
          <Icon name="arrow" size={20} />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--sage" aria-labelledby="ubicacion">
    <div class="container split split--halves">
      <div class="split__aside">
        <SectionHeader
          id="ubicacion"
          eyebrow="Ubicación y privacidad"
          title="Datos de la consulta y uso de tu información"
          intro="Consulta los datos publicados en la web original (dirección en Nules, correo y colegiación médica) y las condiciones de privacidad antes de solicitar tu valoración."
        >
          <ul class="link-list">
            <li>
              <a class="text-link" href={url('politica-de-privacidad/')}>
                <span>Política de privacidad</span>
                <Icon name="arrow" size={20} />
              </a>
            </li>
            <li>
              <a class="text-link" href={url('aviso-legal/')}>
                <span>Aviso legal</span>
                <Icon name="arrow" size={20} />
              </a>
            </li>
          </ul>
        </SectionHeader>
      </div>
      <div class="split__main fact-card" role="region" aria-label="Ubicación y datos de la consulta">
        <dl>
          <div class="fact-card__row">
            <dt>Dirección documentada</dt>
            <dd>{site.address}</dd>
          </div>
          <div class="fact-card__row">
            <dt>Correo electrónico</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div class="fact-card__row">
            <dt>Colegiación médica</dt>
            <dd>Médica colegiada nº {site.collegiateNumber}</dd>
          </div>
          <div class="fact-card__row">
            <dt>Horario de consulta</dt>
            <dd>Atención presencial con cita concertada previamente</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CtaBlock from '../components/CtaBlock.astro';
import SectionNav from '../components/SectionNav.astro';
import PhoneList from '../components/PhoneList.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { consultaSection, site } from '../data/site';
import { url } from '../lib/url';

const breadcrumbs = [
  { label: 'La consulta', path: 'consulta-control-peso-castellon/' },
  { label: 'La clínica', path: 'clinica/' },
];

const publishedServices = [
  {
    title: 'Tratamiento médico y dietético',
    desc: 'Atención clínica y pautas nutricionales individualizadas bajo supervisión médica.',
  },
  {
    title: 'Consejo nutricional',
    desc: 'Reeducación de hábitos alimentarios y aprendizaje para el día a día.',
  },
  {
    title: 'Actividad física adaptada',
    desc: 'Orientación de movimiento progresivo según la condición de salud de cada persona.',
  },
  {
    title: 'Apoyo emocional y motivación',
    desc: 'Acompañamiento en las dificultades del proceso para no afrontarlo en solitario.',
  },
  {
    title: 'Dietas adaptadas a patologías',
    desc: 'Planes específicos ante factores de salud que requieren ajuste clínico particular.',
  },
  {
    title: 'Actividades y talleres publicados',
    desc: 'La web original documentaba talleres de alimentación consciente, sofrología, cocina y salidas activas.',
  },
];

const principles: { icon: IconName; title: string; text: string }[] = [
  { icon: 'lock', title: 'Privacidad', text: 'Las conversaciones sobre tu salud se mantienen en la consulta. La web no pide información clínica.' },
  { icon: 'listen', title: 'Escucha', text: 'Espacio para contar tu situación y resolver dudas, sin juicios sobre tu cuerpo ni sobre tu historia.' },
  { icon: 'followup', title: 'Seguimiento', text: 'La relación no termina en la primera visita: el acompañamiento continúa si decides empezar.' },
];
---

<BaseLayout
  title="La consulta CLIN&DIET en Nules (Castellón) | Dra. Vicenta Cubells"
  description="CLIN&DIET, la consulta de la Dra. Vicenta Cubells en Nules (Castellón): trayectoria documentada desde 2007, inventario de servicios y principios de atención médica."
  pageType="AboutPage"
  breadcrumbs={breadcrumbs}
>
  <Hero
    eyebrow="La clínica"
    title="CLIN&DIET, la consulta de la Dra. Vicenta Cubells en Nules"
    lead="Espacio de consulta médica dedicado al control de peso y la educación nutricional en la provincia de Castellón. La web original sitúa el inicio de su actividad en 2007, con la atención individual, la privacidad y el rigor profesional como principios."
    breadcrumbs={breadcrumbs}
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href={url('contacto/')}>
        Pedir primera valoración
        <Icon name="arrow" size={20} />
      </a>
      <a class="btn btn--secondary" href={url('como-es-la-primera-consulta/')}>Cómo es la consulta</a>
    </Fragment>
    <aside slot="aside" class="fact-card" aria-label="Datos de la consulta">
      <dl>
        <div class="fact-card__row">
          <dt>Responsable médica</dt>
          <dd><a href={url('dra-vicenta-cubells/')}>Dra. Vicenta Cubells</a> (Colegiada nº {site.collegiateNumber})</dd>
        </div>
        <div class="fact-card__row">
          <dt>Ubicación documentada</dt>
          <dd>{site.address}</dd>
        </div>
        <div class="fact-card__row">
          <dt>Correo electrónico</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div class="fact-card__row">
          <dt>Trayectoria histórica</dt>
          <dd>Actividad documentada desde {site.foundedYear} en la web original</dd>
        </div>
        <div class="fact-card__row">
          <dt>Horario</dt>
          <dd>Atención presencial con cita previa</dd>
        </div>
      </dl>
      <PhoneList />
    </aside>
  </Hero>

  <SectionNav items={consultaSection} label="Secciones de La consulta" />

  <section class="section section--flush-top" aria-label="Fotografía de la consulta">
    <div class="container">
      <div class="placeholder placeholder--band" role="note">
        <div>
          <Icon name="notes" size={24} />
          <strong>Espacio de consulta en Nules</strong>
          <p>Espacio reservado para fotografía autorizada de las instalaciones reales de CLIN&amp;DIET en Nules (Castellón).</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--line" aria-labelledby="servicios-publicados">
    <div class="container">
      <SectionHeader
        id="servicios-publicados"
        eyebrow="Inventario publicado"
        title="Servicios y actividades de CLIN&DIET"
        intro="Relación de áreas asistenciales y actividades documentadas en la web original de la consulta. Su disponibilidad actual, formatos y condiciones se confirman directamente con la doctora (esta web no publica calendarios ni convocatorias de inscripción)."
      />
      <ul class="topic-list topic-list--grid mt-56">
        {
          publishedServices.map((service) => (
            <li>
              <span class="topic-list__icon"><Icon name="check" size={20} /></span>
              <div>
                <h3>{service.title}</h3>
                <p>{service.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="notice mt-32">
        <Icon name="notes" size={20} />
        <span>
          <strong>Diferenciación de vigencia:</strong> Este inventario refleja las actividades recogidas en la web original de CLIN&amp;DIET (con inicio documentado en 2007). La disponibilidad específica de talleres de alimentación consciente, salidas o sofrología se consulta directamente con el centro.
        </span>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="principios">
    <div class="container">
      <SectionHeader
        id="principios"
        eyebrow="Forma de trabajar"
        title="Lo que guía cada consulta"
        intro="Son principios de trabajo, no garantías de resultado. Describen cómo se entiende la relación con cada persona."
      >
        <a class="text-link" href={url('como-es-la-primera-consulta/')}>
          <span>Cómo es la primera consulta</span>
          <Icon name="arrow" size={20} />
        </a>
      </SectionHeader>
      <div class="principles mt-56">
        {
          principles.map((item) => (
            <div class="principle">
              <Icon name={item.icon} />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>


  <CtaBlock
    eyebrow="Primer paso"
    title="Conoce la consulta en una primera valoración"
    text="Es la mejor forma de saber si el enfoque encaja contigo, sin compromiso de continuar."
    primary={{ label: 'Pedir primera valoración', path: 'contacto/' }}
    secondary={{ label: 'Preguntas frecuentes', path: 'preguntas-frecuentes/' }}
  />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Timeline from '../components/Timeline.astro';
import Faq from '../components/Faq.astro';
import CtaBlock from '../components/CtaBlock.astro';
import PhoneList from '../components/PhoneList.astro';
import Icon from '../components/Icon.astro';
import SectionNav from '../components/SectionNav.astro';
import { consultaSection, firstVisitSteps } from '../data/site';
import { pickFaqs } from '../data/faqs';
import { url } from '../lib/url';

const breadcrumbs = [
  { label: 'La consulta', path: 'consulta-control-peso-castellon/' },
  { label: 'Primera consulta', path: 'como-es-la-primera-consulta/' },
];
const faqs = pickFaqs(['valoracion-preparar', 'valoracion-compromiso', 'privacidad-telefono']);

const details = [
  { label: 'Qué aportas', text: 'Datos básicos de localización. La web no te pedirá historial clínico.' },
  { label: 'Qué se acuerda', text: 'El día y la hora para la valoración presencial en la consulta de Nules.' },
  { label: 'Qué ocurre', text: 'Conversación directa con la doctora para conocer tu estado de salud y hábitos.' },
  { label: 'Qué decides', text: 'La doctora te explica si procede acompañamiento. Decides libremente y sin compromiso.' },
];
const steps = firstVisitSteps.map((step, i) => ({ ...step, detail: details[i].text, detailLabel: details[i].label }));

const canPrepare = [
  { title: 'Informes o analíticas recientes', text: 'Sugerencia voluntaria, si dispones de ellos. Los revisará la doctora en la consulta.' },
  { title: 'Tu medicación habitual', text: 'Una lista orientativa de lo que tomas, incluidos suplementos o tratamientos actuales.' },
  { title: 'Tus dudas anotadas', text: 'Para tener presentes las preguntas que desees plantear durante la consulta.' },
];

const noNeed = [
  { title: 'Enviar datos de salud por la web', text: 'Ni informes, ni diagnósticos, ni medicación a través del formulario.' },
  { title: 'Tener todo decidido de antemano', text: 'La consulta médica es precisamente el espacio para resolver dudas y valorar opciones.' },
  { title: 'Comprometerte a iniciar tratamiento', text: 'La primera valoración no obliga a comenzar ningún plan posterior.' },
];
---

<BaseLayout
  title="Cómo es la primera valoración médica en Nules (Castellón) | Dra. Vicenta Cubells"
  description="Información para tu primera valoración de control de peso en Nules (Castellón): cómo solicitar cita sin compromiso y qué puedes preparar para la visita."
  breadcrumbs={breadcrumbs}
>
  <Hero
    eyebrow="Primera consulta"
    title="Cómo es la primera valoración médica"
    lead="Cómo solicitar cita, qué puedes preparar de forma voluntaria y qué esperar de la valoración médica en Nules."
    breadcrumbs={breadcrumbs}
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href={url('contacto/')}>
        Solicitar cita
        <Icon name="arrow" size={20} />
      </a>
    </Fragment>
    <aside slot="aside" class="fact-card" aria-label="Teléfonos de la consulta">
      <PhoneList variant="cards" label="Pide tu valoración por teléfono" />
    </aside>
  </Hero>

  <SectionNav items={consultaSection} label="Secciones de La consulta" />

  <section class="section" aria-labelledby="pasos">
    <div class="container split">
      <div class="split__aside">
        <div class="sticky">
          <SectionHeader
            id="pasos"
            eyebrow="Primera consulta"
            title="El recorrido de la primera consulta"
            intro="Información práctica para conocer los momentos de contacto y valoración."
          />
        </div>
      </div>
      <div class="split__main">
        <Timeline steps={steps} layout="vertical" />
      </div>
    </div>
  </section>

  <section class="section section--sage" aria-labelledby="preparar">
    <div class="container">
      <SectionHeader
        id="preparar"
        eyebrow="Sugerencias orientativas"
        title="Qué puedes preparar voluntariamente y qué no necesitas"
        intro="Cualquier información clínica sobre tu salud se evalúa de manera confidencial en la consulta médica, nunca a través de la web."
      />
      <div class="split split--halves mt-56">
        <div class="split__aside">
          <h3>Puedes preparar, si quieres</h3>
          <ul class="check-list mt-32">
            {
              canPrepare.map((item) => (
                <li>
                  <Icon name="check" />
                  <div>
                    <strong>{item.title}</strong>
                    <span>{item.text}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="split__main">
          <h3>No necesitas</h3>
          <ul class="check-list check-list--muted mt-32">
            {
              noNeed.map((item) => (
                <li>
                  <Icon name="close" />
                  <div>
                    <strong>{item.title}</strong>
                    <span>{item.text}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-primera">
    <div class="container split">
      <div class="split__aside">
        <SectionHeader id="faq-primera" eyebrow="Preguntas frecuentes" title="Antes de pedir cita">
          <a class="text-link" href={url('preguntas-frecuentes/')}>
            <span>Ver todas las preguntas</span>
            <Icon name="arrow" size={20} />
          </a>
        </SectionHeader>
      </div>
      <div class="split__main">
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <CtaBlock
    eyebrow="Cuando quieras"
    title="Solicita tu valoración cuando te venga bien"
    text="Llama a la consulta o deja una solicitud de contacto con tus datos básicos."
    primary={{ label: 'Solicitar cita', path: 'contacto/' }}
  />
</BaseLayout>

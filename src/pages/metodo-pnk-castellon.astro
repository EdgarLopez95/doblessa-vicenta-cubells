---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PillarCard from '../components/PillarCard.astro';
import Faq from '../components/Faq.astro';
import CtaBlock from '../components/CtaBlock.astro';
import ReviewNote from '../components/ReviewNote.astro';
import StatementBand from '../components/StatementBand.astro';
import Icon from '../components/Icon.astro';
import { pickFaqs } from '../data/faqs';
import { url } from '../lib/url';

const breadcrumbs = [{ label: 'El método', path: 'metodo-pnk-castellon/' }];

const faqs = pickFaqs([
  'metodo-que-es',
  'metodo-lipoinflamacion',
  'metodo-proteindha',
  'metodo-pasos',
  'metodo-equipo',
  'metodo-para-mi',
  'metodo-web',
]);

const fourPillars = [
  {
    icon: 'medical',
    title: 'Control médico prescriptor',
    text: 'La web original presenta a la Dra. Vicenta Cubells como médica vinculada al método y describe el control facultativo como parte del tratamiento.',
  },
  {
    icon: 'nutrition',
    title: 'Pauta nutricional y ProteinDHA®',
    text: 'Aporte de proteínas de alto valor biológico junto a suplementación de DHA orientada al abordaje de la lipoinflamación celular.',
  },
  {
    icon: 'movement',
    title: 'Actividad física progresiva',
    text: 'El método incluye pautas de actividad física como parte de su abordaje multidisciplinar.',
  },
  {
    icon: 'coaching',
    title: 'Coaching y apoyo en hábitos',
    text: 'Acompañamiento motivacional y resolución de dificultades cotidianas para afianzar el cambio de estilo de vida.',
  },
] as const;

const stepGroups = [
  {
    title: 'Pasos 1, 2 y 3',
    text: 'La web original agrupa aquí la etapa inicial de pérdida de peso: describe una dieta cetogénica ProteinDHA®, aporte de DHA, actividad física y apoyo de coaching.',
  },
  {
    title: 'Pasos 4 y 5',
    text: 'Los dos pasos finales del primer momento se describen como una evolución hacia el equilibrio dietético, con reintroducción progresiva de alimentos y nuevos hábitos.',
  },
];

const questions = [
  '¿Es este enfoque clínicamente adecuado para mi estado de salud?',
  '¿Cómo interactúa con mi medicación habitual o patologías previas?',
  '¿Con qué frecuencia se realizan las analíticas y revisiones médicas?',
  '¿Qué papel tiene la suplementación de DHA en mi caso particular?',
  '¿Qué alternativas médicas existen si el método no es la opción indicada?',
];
---

<BaseLayout
  title="Método PnK® con prescripción médica en Nules (Castellón) | Dra. Vicenta Cubells"
  description="Información médica sobre el Método PnK® documentado en la web original: control facultativo, fórmula ProteinDHA®, DHA, abordaje de la lipoinflamación, dos momentos y cinco pasos en Nules (Castellón)."
  breadcrumbs={breadcrumbs}
>
  <Hero
    eyebrow="El método"
    title="Método PnK® con prescripción y seguimiento médico en Nules"
    lead="Tratamiento médico multidisciplinar para la pérdida de peso y la reeducación alimentaria. Documentado en la web original como un abordaje integral que combina supervisión médica individual, nutrición con ProteinDHA®, suplementación con DHA para abordar la lipoinflamación, actividad física y apoyo en hábitos."
    breadcrumbs={breadcrumbs}
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href={url('contacto/')}>
        Conocer si es adecuado para mí
        <Icon name="arrow" size={20} />
      </a>
      <a class="btn btn--secondary" href={url('consulta-control-peso-castellon/')}>Ver cómo es la consulta</a>
    </Fragment>
    <div slot="after" class="mt-32">
      <p class="notice">
        <Icon name="notes" size={20} />
        <span>
          <strong>Información procedente de la web original.</strong> La denominación Método PnK® / PronoKal®, su descripción y marcas asociadas pertenecen a sus titulares; su uso comercial definitivo requiere confirmación de derechos y revisión clínica.
        </span>
      </p>
    </div>
  </Hero>

  <section class="section section--line" aria-labelledby="marco-metodo">
    <div class="container split">
      <div class="split__aside">
        <SectionHeader
          id="marco-metodo"
          eyebrow="Bases documentadas"
          title="Lipoinflamación, ProteinDHA® y control médico"
        />
      </div>
      <div class="split__main prose-block">
        <p class="lead">
          La web original de la Dra. Vicenta Cubells explica el Método PnK® a través de tres conceptos nucleares: el control médico individual, la intervención sobre la <strong>lipoinflamación</strong> y la fórmula patentada <strong>ProteinDHA®</strong>.
        </p>
        <p>
          En la literatura divulgativa del método, la <strong>lipoinflamación</strong> se define como una respuesta inflamatoria de bajo grado que se produce en el tejido adiposo al aumentar de volumen las células grasas. Para combatirla, el protocolo incorpora pautas de cetosis controlada junto a la administración pautada de <strong>DHA</strong> (ácido docosahexaenoico, omega-3).
        </p>
        <p>
          No se presenta como una dieta para seguir por cuenta propia: la web original describe valoración y seguimiento médico dentro del método. La pauta individual corresponde a la consulta.
        </p>
      </div>
    </div>
  </section>

  <StatementBand
    tone="sage"
    text="El método aporta la estructura científica. La valoración médica individual determina si está indicado para ti."
  />

  <section class="section section--sage" aria-labelledby="cuatro-pilares">
    <div class="container">
      <SectionHeader
        id="cuatro-pilares"
        eyebrow="Abordaje multidisciplinar"
        title="Los cuatro componentes del método"
        intro="Una intervención integral documentada en el sitio original donde el criterio clínico dirige cada área de trabajo."
      />
      <div class="pillars pillars--four mt-56">
        {fourPillars.map((area, i) => <PillarCard icon={area.icon} index={i + 1} title={area.title} text={area.text} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="fases-metodo">
    <div class="container">
      <SectionHeader
        id="fases-metodo"
        eyebrow="Estructura del tratamiento"
        title="Dos momentos y cinco pasos"
        intro="La web original sitúa los cinco pasos dentro del momento de pérdida de peso. El momento «Mi nuevo estilo de vida» comienza después del paso 5."
      />

      <div class="split split--halves mt-56">
        <div class="split__aside">
          <h3>Momento 1: Pérdida de peso (cinco pasos)</h3>
          <p class="text-muted mt-8">La fuente describe los cinco pasos en dos grupos, sin detallar una pauta alimentaria para cada paso.</p>
          <ol class="value-list mt-32">
            {
              stepGroups.map((item, i) => (
                <li>
                  <span class="value-list__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="split__main">
          <h3>Momento 2: Mi nuevo estilo de vida</h3>
          <p class="text-muted mt-8">Comienza después de completar el paso 5, una vez alcanzado el peso objetivo. La web original lo describe como un periodo para afianzar los cambios de hábitos, con apoyo de asesoría dietética, actividad física y coaching.</p>
        </div>
      </div>

      <p class="notice mt-56">
        <Icon name="shield" />
        <span>
          <strong>Prudencia sanitaria:</strong> Esta descripción es meramente divulgativa y no constituye pauta dietética ni garantía de resultados. Cada organismo presenta ritmos propios y el paso de una fase a otra se decide en consulta según analíticas y criterio médico.
        </span>
      </p>
    </div>
  </section>

  <section class="section section--line" aria-labelledby="equipo-actores">
    <div class="container split">
      <div class="split__aside">
        <SectionHeader
          id="equipo-actores"
          eyebrow="Diferenciación de funciones"
          title="Atención médica en CLIN&DIET y recursos del método"
          intro="Es fundamental distinguir la labor facultativa que se presta en la consulta de Nules del ecosistema de apoyo proporcionado por el Método PnK®."
        />
      </div>
      <div class="split__main prose-block">
        <h3>La Dra. Vicenta Cubells en CLIN&DIET (Nules)</h3>
        <p>
          La web original presenta a la Dra. Vicenta Cubells como médica formadora en los métodos PronoKal, PnK y Diaprokal. También describe la valoración, la prescripción y el seguimiento médico como componentes del método, sin detallar aquí el reparto de funciones de cada profesional en la consulta de Nules.
        </p>

        <h3 class="mt-32">El soporte del ecosistema PnK®</h3>
        <p>
          La web antigua documentaba recursos complementarios que el método pone a disposición de las personas en tratamiento:
        </p>
        <ul class="check-list mt-16">
          <li>
            <Icon name="check" />
            <div>
              <strong>Dietistas-coach del método:</strong> Asesoramiento nutricional de refuerzo y resolución de dudas sobre recetas y productos.
            </div>
          </li>
          <li>
            <Icon name="check" />
            <div>
              <strong>Técnicos de actividad física:</strong> Guías de ejercicio progresivo diseñadas específicamente para cada etapa.
            </div>
          </li>
          <li>
            <Icon name="check" />
            <div>
              <strong>Plataforma Club PnK®:</strong> Entorno digital documentado en el sitio original con herramientas de apoyo y seguimiento para pacientes.
            </div>
          </li>
        </ul>
        <p class="credentials__note mt-16">
          La web original no precisa qué profesionales del método atienden presencialmente en Nules ni su relación contractual con CLIN&amp;DIET.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--brass" aria-labelledby="dudas">
    <div class="container">
      <SectionHeader
        id="dudas"
        eyebrow="Antes de decidir"
        title="Preguntas clínicas que conviene plantear en consulta"
        intro="La primera valoración médica en Nules es el espacio adecuado para resolver dudas técnicas sobre tu idoneidad personal para el método."
      />
      <ol class="question-list question-list--grid mt-56">
        {questions.map((question) => <li>{question}</li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-metodo">
    <div class="container split">
      <div class="split__aside">
        <SectionHeader id="faq-metodo" eyebrow="Preguntas frecuentes" title="Dudas sobre el Método PnK®">
          <a class="text-link" href={url('preguntas-frecuentes/')}>
            <span>Ver todas las preguntas frecuentes</span>
            <Icon name="arrow" size={20} />
          </a>
        </SectionHeader>
      </div>
      <div class="split__main">
        <Faq items={faqs} />
        <div class="mt-56">
          <ReviewNote
            text="La denominación Método PnK® / Pronokal y su descripción técnica proceden de la web original; están pendientes de validación formal con el titular de la marca y de revisión clínica antes de su publicación real."
          />
        </div>
      </div>
    </div>
  </section>

  <CtaBlock
    eyebrow="¿Es para ti?"
    title="Solo una valoración médica individual puede determinarlo"
    text="Pedir una valoración en Nules no te compromete a iniciar el tratamiento. Es el paso necesario para conocer si este marco clínico encaja con tu salud."
    primary={{ label: 'Conocer si es adecuado para mí', path: 'contacto/' }}
    secondary={{ label: 'Cómo es la primera consulta', path: 'como-es-la-primera-consulta/' }}
  />
</BaseLayout>
